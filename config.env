# ===== Bash Maintenance Suite Configuration =====

# ✅ Space-separated OR newline-separated list of source directories.
#    Tip (WSL users): replace WindowsUsername with yours if you want Windows folders.
# BACKUP_SOURCE_DIRS supports both of these forms:
# BACKUP_SOURCE_DIRS="${HOME}/Documents ${HOME}/Pictures"
# BACKUP_SOURCE_DIRS="${HOME}/Documents
# ${HOME}/Pictures
# /mnt/c/Users/WindowsUsername/Documents
# /mnt/c/Users/WindowsUsername/Pictures"
BACKUP_SOURCE_DIRS="${HOME}/Documents ${HOME}/Pictures"

# Where backup archives are stored
BACKUP_DEST_DIR="${HOME}/backups"

# Days to keep old backups (0 disables pruning)
BACKUP_RETENTION_DAYS=14

# Non-interactive mode (recommended for cron)
NON_INTERACTIVE=true

# Log monitoring (unchanged)
LOG_MONITOR_PATTERNS="ERROR|CRITICAL|FAIL|panic|segfault"
LOG_MONITOR_SINCE_MINUTES=60
LOG_MONITOR_FILES="/var/log/syslog /var/log/messages /var/log/auth.log"
ALERT_METHOD="log"
ALERT_EMAIL="root@localhost"
